# ============================================================
#  Restaurant Admin — Environment Template
#  Copy to ".env" and fill in real values. Do NOT commit ".env".
# ============================================================

# ----- Database (MySQL) -----
# URL-encode special chars in the password (e.g. @ -> %40).
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DB_NAME"

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_db
DB_PORT=3306

# ----- SSH tunnel to the remote DB (dev PC only) -----
# On a dev PC set DATABASE_URL/DB_PORT to 127.0.0.1:33663 and run
# `npm run start:local` (tunnel + server) or `npm run tunnel` (prisma CLI).
# Leave these empty on the server, where MySQL is local on 3306.
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
DB_TUNNEL_PORT=33663
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=3306

# ----- Auth.js (NextAuth) -----
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3001

# ----- SMTP (emails) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
